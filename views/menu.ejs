<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu ~ Bean & Brew</title>
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/styles/output.css">
</head>
<body class="font-prompt">
    <%- include('./partials/navbar') %>
    
    <main class="overflow-hidden">
        <!-- Hero Section with Parallax -->
        <section class="relative h-[80vh] bg-fixed bg-cover bg-center"
                 style="background-image: url('/images/menu_parallax.webp');">
            <div class="absolute inset-0 bg-black bg-opacity-40"></div>
            
            <!-- Center content with flex -->
            <div class="relative flex items-center justify-center h-full">
                <div class="container mx-auto px-6">
                    <div class="max-w-5xl mx-auto text-center text-white space-y-12 mt-16">
                        <h1 class="text-7xl md:text-8xl lg:text-9xl font-nerko leading-none animate__animated animate__fadeIn">
                            Our Menu
                        </h1>
                        <p class="text-2xl md:text-3xl font-light tracking-wide animate__animated animate__fadeIn animate__delay-1s">
                            Discover Our Handcrafted Selection
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Menu Content -->
        <section class="bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Category Navigation -->
                <div class="py-8 sticky top-0 bg-white/80 backdrop-blur-md z-10">
                    <nav class="flex justify-center space-x-6">
                        <% if (locals.categories && categories.length > 0) { %>
                            <% categories.forEach(category => { %>
                                <a href="#<%= category.id %>" 
                                   class="text-dark-green hover:text-light-green transition-colors duration-300 font-nerko text-lg">
                                    <%= category.name %>
                                </a>
                            <% }); %>
                        <% } %>
                    </nav>
                </div>

                <!-- Menu Items -->
                <div class="space-y-16 py-12">
                    <% if (locals.categories && categories.length > 0) { %>
                        <% categories.forEach(category => { %>
                            <section id="<%= category.id %>">
                                <h2 class="text-4xl font-nerko text-dark-green mb-12 text-center"><%= category.name %></h2>
                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                                    <% const categoryItems = menu.filter(item => item.category === category.id); %>
                                    <% if (categoryItems.length > 0) { %>
                                        <% categoryItems.forEach(item => { %>
                                            <!-- Item card template -->
                                            <div class="group relative flex flex-col items-center p-4">
                                                <!-- Image Circle with Price Label -->
                                                <div class="relative mb-4">
                                                    <!-- Price Label -->
                                                    <div class="absolute top-2 right-2 z-10 bg-dark-green text-white px-3 py-1 rounded-full 
                                                                shadow-lg transform -translate-y-2 translate-x-2">
                                                        <span class="font-semibold">£<%= item.price.toFixed(2) %></span>
                                                    </div>
                                                    
                                                    <!-- Circular Image Container -->
                                                    <div class="w-48 h-48 rounded-full overflow-hidden border-4 border-dark-green 
                                                                shadow-lg group-hover:shadow-xl transition-all duration-300">
                                                        <div class="w-full h-full bg-dark-green/10">
                                                            <img src="<%= item.imageUrl %>" 
                                                                 alt="<%= item.name %>" 
                                                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                                                            >
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <!-- Content Below Circle -->
                                                <div class="text-center space-y-2 max-w-[200px]">
                                                    <h3 class="text-xl font-nerko text-dark-green group-hover:text-light-green 
                                                               transition-colors duration-300">
                                                        <%= item.name %>
                                                    </h3>
                                                    <p class="text-gray-600 text-sm line-clamp-2">
                                                        <%= item.description %>
                                                    </p>
                                                    
                                                    <!-- Add to Cart Button -->
                                                    <div class="pt-4">
                                                        <% if (item.stockQuantity > 0) { %>
                                                            <button onclick="addToCart('<%= item._id %>')" 
                                                                    class="bg-dark-green text-white px-4 py-2 rounded-full hover:bg-light-green 
                                                                           transition-all duration-300 flex items-center space-x-2 mx-auto">
                                                                <span class="text-sm font-medium">Add to Cart</span>
                                                                <i class="fas fa-plus text-xs"></i>
                                                            </button>
                                                        <% } else { %>
                                                            <span class="text-red-500 text-sm font-medium">Out of Stock</span>
                                                        <% } %>
                                                    </div>

                                                    <% if (userType === 'employee') { %>
                                                        <div class="mt-4 pt-4 border-t border-gray-200">
                                                            <p class="text-sm text-gray-600">
                                                                Stock: <%= item.stockQuantity %> units
                                                            </p>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="col-span-full text-center text-gray-600">
                                            <p>No items available in this category</p>
                                        </div>
                                    <% } %>
                                </div>
                            </section>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center text-gray-600">
                            <p>No menu categories available</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <%- include('./partials/footer') %>

    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>
</body>
</html>