<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu</title>
    <link rel="stylesheet" href="/styles/output.css">
</head>
<body>
    <%- include('partials/navbar') %>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <h1 class="text-4xl font-nerko text-dark-green text-center mb-12">Our Menu</h1>
        
        <% if (userType === 'employee') { %>
            <form action="/add-product" method="POST" class="add-product-form">
                <h2>Add New Product</h2>
                <div class="form-group">
                    <label for="name">Name:</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="price">Price:</label>
                    <input type="number" id="price" name="price" required>
                </div>
                <div class="form-group">
                    <label for="imageUrl">Image URL:</label>
                    <input type="text" id="imageUrl" name="imageUrl" required>
                </div>
                <div class="form-group">
                    <label for="stockQuantity">Stock Quantity:</label>
                    <input type="number" id="stockQuantity" name="stockQuantity" required>
                </div>
                <div class="form-group">
                    <label for="description">Description:</label>
                    <textarea id="description" name="description" required></textarea>
                </div>
                <button type="submit">Add Product</button>
            </form>
        <% } %>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% menu.forEach(item => { %>
                <div class="card hover:shadow-lg transition-shadow duration-300">
                    <img src="<%= item.image %>" alt="<%= item.name %>" 
                        class="w-full h-48 object-cover rounded-t-lg">
                    <div class="p-4">
                        <h3 class="text-xl font-nerko text-dark-green"><%= item.name %></h3>
                        <p class="text-gray-600 mt-2"><%= item.description %></p>
                        <div class="mt-4 flex justify-between items-center">
                            <span class="text-coffee-brown font-semibold">£<%= item.price.toFixed(2) %></span>
                            <button onclick="addToCart('<%= item._id %>')" 
                                class="btn-primary">
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        
        <% if (products && products.length > 0) { %>
            <div class="products-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <img src="<%= product.imageUrl %>" alt="<%= product.name %>">
                        <h3><%= product.name %></h3>
                        <p><%= product.description %></p>
                        <p class="price">£<%= product.price.toFixed(2) %></p>
                        <% if (userType === 'employee') { %>
                            <p>Stock: <%= product.stockQuantity %></p>
                            <form action="/set-stock" method="POST" class="set-stock-form">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <div class="form-group">
                                    <label for="stockQuantity">Set Stock Quantity:</label>
                                    <input type="number" id="stockQuantity" name="stockQuantity" required>
                                </div>
                                <button type="submit">Set Stock</button>
                            </form>
                            <form action="/reorder-stock" method="POST" class="reorder-stock-form">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <div class="form-group">
                                    <label for="quantity">Reorder Quantity:</label>
                                    <input type="number" id="quantity" name="quantity" required>
                                </div>
                                <button type="submit">Reorder Stock</button>
                            </form>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p>No products available at the moment.</p>
        <% } %>
    </div>

    <%- include('partials/footer') %>
</body>
</html>