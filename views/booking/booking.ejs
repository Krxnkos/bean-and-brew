<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book a Table ~ Bean & Brew</title>
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/styles/output.css">
</head>
<body class="font-prompt">
    <%- include('../partials/navbar') %>

    <!-- Parallax Hero Section -->
    <section class="relative h-[80vh] bg-fixed bg-cover bg-center"
             style="background-image: url('/images/order_parallax.webp');">
        <div class="absolute inset-0 bg-black bg-opacity-40"></div>
        
        <div class="relative flex items-center justify-center h-full">
            <div class="container mx-auto px-6">
                <div class="max-w-5xl mx-auto text-center text-white space-y-12 mt-16">
                    <h1 class="text-7xl md:text-8xl lg:text-9xl font-nerko leading-none animate__animated animate__fadeIn">
                        Book a Table
                    </h1>
                    <p class="text-2xl md:text-3xl font-light tracking-wide animate__animated animate__fadeIn animate__delay-1s">
                        Reserve Your Perfect Spot
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Booking Section -->
    <section class="py-16 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Form Card -->
            <div class="bg-cream rounded-2xl shadow-2xl overflow-hidden">
                <!-- Form Header -->
                <div class="bg-dark-green p-8 text-white">
                    <h2 class="text-3xl font-nerko text-center">Reserve Your Table</h2>
                    <p class="text-center text-white/80 mt-2">Experience the perfect coffee moment</p>
                </div>

                <!-- Form Content -->
                <form id="bookingForm" class="p-8 space-y-8">
                    <!-- Location Selection -->
                    <div class="form-group">
                        <label for="location" class="block text-lg font-nerko text-dark-green mb-2">
                            <i class="fas fa-map-marker-alt mr-2"></i>Location
                        </label>
                        <div class="relative">
                            <select name="location" id="location" required
                                    class="w-full p-4 rounded-xl border-2 border-dark-green/10 focus:border-light-green 
                                           focus:ring-2 focus:ring-light-green bg-white text-dark-green appearance-none">
                                <option value="">Select a location</option>
                                <option value="Leeds">Leeds City Centre</option>
                                <option value="Harrogate">Harrogate Springs</option>
                                <option value="Knaresborough">Knaresborough Castle</option>
                            </select>
                            <div class="absolute right-4 top-1/2 transform -translate-y-1/2 text-dark-green/50 pointer-events-none">
                                <i class="fas fa-chevron-down"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Date and Time Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Date Selection -->
                        <div class="form-group">
                            <label for="date" class="block text-lg font-nerko text-dark-green mb-2">
                                <i class="fas fa-calendar mr-2"></i>Date
                            </label>
                            <div class="relative">
                                <input type="date" name="date" id="date" required
                                       class="w-full p-4 rounded-xl border-2 border-dark-green/10 focus:border-light-green 
                                              focus:ring-2 focus:ring-light-green bg-white text-dark-green">
                            </div>
                        </div>

                        <!-- Time Selection -->
                        <div class="form-group">
                            <label for="time" class="block text-lg font-nerko text-dark-green mb-2">
                                <i class="fas fa-clock mr-2"></i>Time
                            </label>
                            <div class="relative">
                                <select name="time" id="time" required
                                        class="w-full p-4 rounded-xl border-2 border-dark-green/10 focus:border-light-green 
                                               focus:ring-2 focus:ring-light-green bg-white text-dark-green appearance-none">
                                    <option value="">Select time</option>
                                    <% for(let i = 9; i <= 20; i++) { %>
                                        <option value="<%= i %>:00"><%= i.toString().padStart(2, '0') %>:00</option>
                                        <option value="<%= i %>:30"><%= i.toString().padStart(2, '0') %>:30</option>
                                    <% } %>
                                </select>
                                <div class="absolute right-4 top-1/2 transform -translate-y-1/2 text-dark-green/50 pointer-events-none">
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Guests Selection -->
                    <div class="form-group">
                        <label for="guests" class="block text-lg font-nerko text-dark-green mb-2">
                            <i class="fas fa-users mr-2"></i>Number of Guests
                        </label>
                        <div class="relative">
                            <input type="number" name="guests" id="guests" min="1" max="8" required
                                   class="w-full p-4 rounded-xl border-2 border-dark-green/10 focus:border-light-green 
                                          focus:ring-2 focus:ring-light-green bg-white text-dark-green">
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="pt-6">
                        <button type="submit" 
                                class="w-full bg-dark-green text-white px-8 py-4 rounded-xl hover:bg-light-green 
                                       transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg
                                       font-nerko text-xl flex items-center justify-center space-x-3">
                            <span>Confirm Reservation</span>
                            <i class="fas fa-check-circle"></i>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Booking Message -->
            <div id="bookingMessage" class="mt-8 text-center hidden"></div>
        </div>
    </section>

    <%- include('../partials/footer') %>

    <script>
        document.getElementById('bookingForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const bookingData = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/api/bookings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(bookingData)
                });

                const result = await response.json();
                const bookingMessage = document.getElementById('bookingMessage');
                bookingMessage.classList.remove('hidden');

                if (response.ok) {
                    bookingMessage.textContent = 'Booking confirmed!';
                    bookingMessage.classList.add('text-green-500');
                } else {
                    bookingMessage.textContent = `Error: ${result.message}`;
                    bookingMessage.classList.add('text-red-500');
                }
            } catch (error) {
                const bookingMessage = document.getElementById('bookingMessage');
                bookingMessage.classList.remove('hidden');
                bookingMessage.textContent = `Error: ${error.message}`;
                bookingMessage.classList.add('text-red-500');
            }
        });
    </script>
</body>
</html>