<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Online ~ Bean & Brew</title>
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/styles/output.css">
</head>
<body class="font-prompt">
    <%- include('../partials/navbar') %>

    <div class="bg-dark-green/95 py-4">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-white text-center">
                <% if (user && user.firstName) { %>
                    <p class="text-xl font-nerko">Ordering as: <%= user.firstName %></p>
                <% } else { %>
                    <p class="text-xl font-nerko">Ordering as: Guest</p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Hero Section with Parallax -->
    <section class="relative h-[80vh] bg-fixed bg-cover bg-center"
             style="background-image: url('/images/order_parallax.webp');">
        <div class="absolute inset-0 bg-black bg-opacity-40"></div>
        
        <div class="relative flex items-center justify-center h-full">
            <div class="container mx-auto px-6">
                <div class="max-w-5xl mx-auto text-center text-white space-y-12 mt-16">
                    <h1 class="text-7xl md:text-8xl lg:text-9xl font-nerko leading-none animate__animated animate__fadeIn">
                        Order Online
                    </h1>
                    <p class="text-2xl md:text-3xl font-light tracking-wide animate__animated animate__fadeIn animate__delay-1s">
                        Fresh & Delicious, Straight to You
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Order Content -->
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Menu Items -->
                <div class="lg:w-2/3">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <% if (products && products.length > 0) { %>
                            <% products.forEach(product => { %>
                                <div class="bg-cream rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300">
                                    <img src="<%= product.imageUrl %>" 
                                         alt="<%= product.name %>"
                                         class="w-full h-48 object-cover">
                                    <div class="p-6">
                                        <h3 class="text-xl font-nerko text-dark-green mb-2"><%= product.name %></h3>
                                        <p class="text-gray-600 text-sm mb-4"><%= product.description %></p>
                                        <div class="flex justify-between items-center">
                                            <span class="text-dark-green font-semibold">£<%= product.price.toFixed(2) %></span>
                                            <button class="add-to-cart-btn" 
                                                    data-item='<%= JSON.stringify({name: product.name, price: product.price}) %>'>
                                                Add to Cart
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-span-full text-center text-gray-600">
                                <p>No menu items available.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Cart Section -->
                <div class="lg:w-1/3">
                    <div class="bg-cream rounded-xl p-6 shadow-lg sticky top-24">
                        <h2 class="text-2xl font-nerko text-dark-green mb-6">Your Cart</h2>
                        <div id="cart-items" class="space-y-4 max-h-[400px] overflow-y-auto mb-6">
                            <!-- Cart items will be inserted here by JavaScript -->
                        </div>
                        <div class="border-t border-gray-200 pt-4">
                            <div class="flex justify-between items-center mb-6">
                                <span class="text-lg font-nerko text-dark-green">Total:</span>
                                <span id="cart-total" class="text-xl font-semibold text-dark-green">£0.00</span>
                            </div>
                            <button id="checkout-btn">
                                Proceed to Checkout
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>

    <script src="/javascript/cart.js"></script>
    <script>
        // Initialize cart from localStorage
        const savedCart = localStorage.getItem('cart');
        if (savedCart) {
            cart = JSON.parse(savedCart);
            updateCartDisplay();
        }

        // Replace inline event handlers with event listeners
        document.addEventListener('DOMContentLoaded', function() {
            // Add to cart buttons
            document.querySelectorAll('.add-to-cart-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const itemData = JSON.parse(this.dataset.item);
                    addToCart(itemData);
                });
            });

            // Remove from cart buttons
            document.querySelectorAll('.remove-from-cart-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const itemName = this.dataset.itemName;
                    removeFromCart(itemName);
                });
            });

            // Checkout button
            const checkoutBtn = document.getElementById('checkout-btn');
            if (checkoutBtn) {
                checkoutBtn.addEventListener('click', checkout);
            }
        });
    </script>
</body>
</html>