<!DOCTYPE html>
<html>
<head>
    <title>Employee Dashboard - Bean & Brew</title>
    <link href="https://fonts.googleapis.com/css2?family=Nerko+One&family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/output.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="dashboard-container">
        <h1>Welcome, <%= user.firstName %> <%= user.lastName %>!</h1>
        
        <div class="dashboard-grid">
            <% if (userType === 'employee') { %>
                <!-- Employee View -->
                <% if (typeof manager !== 'undefined' && manager) { %>
                    <div class="dashboard-card">
                        <h2>Your Manager</h2>
                        <div class="team-member-list-item">
                            <div class="member-avatar">
                                <img src="<%= manager.profilePicture || '/images/default-profile.png' %>" 
                                     alt="Manager"
                                     onerror="this.src='/images/default-profile.png'">
                            </div>
                            <div class="member-info">
                                <h3><%= manager.firstName %> <%= manager.lastName %></h3>
                                <p class="job-title"><%= manager.jobTitle || 'Manager' %></p>
                                <p class="email"><%= manager.email %></p>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } %>

            <!-- Include other partials -->
            <%- include('../partials/team-members', { teamMembers }) %>
            <%- include('../partials/shifts', { shifts }) %>
            <%- include('../partials/popular-items', { popularItems }) %>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script>
    function assignShift(employeeId) {
        console.log('Assigning shift to employee:', employeeId);
        // Add shift assignment functionality here
    }
    </script>
</body>
</html>